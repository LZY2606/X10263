{
  "title": "堆影取证室：内存快照、弱引用边与保留路径候选",
  "version": "1.0.0",
  "steps": [
    { "op": "import", "file": "baseline.hsf", "sourceName": "基线快照（初始版本）" },
    { "op": "import", "file": "scenario-cycle.hsf", "sourceName": "反例：循环图" },
    { "op": "import", "file": "scenario-weakref.hsf", "sourceName": "反例：弱引用策略" },
    { "op": "import", "file": "scenario-duplicate-address.hsf", "sourceName": "反例：重复地址" },
    { "op": "import", "file": "scenario-incomplete.hsf", "sourceName": "反例：不完整对象" },
    { "op": "import", "file": "scenario-multiroot.hsf", "sourceName": "反例：多 root 等长路径" },
    { "op": "import", "file": "scenario-classrename-a.hsf", "sourceName": "反例：类改名（前像）" },
    { "op": "import", "file": "scenario-classrename-b.hsf", "sourceName": "反例：类改名（后像）" },
    { "op": "analyze", "snapshot": "snap-base-001", "paramsVersion": 1 },
    { "op": "analyze", "snapshot": "snap-scn-cycle", "paramsVersion": 1 },
    { "op": "analyze", "snapshot": "snap-scn-weak", "paramsVersion": 1 },
    { "op": "analyze", "snapshot": "snap-scn-dupaddr", "paramsVersion": 1 },
    { "op": "analyze", "snapshot": "snap-scn-incomplete", "paramsVersion": 1 },
    { "op": "analyze", "snapshot": "snap-scn-multiroot", "paramsVersion": 1 },
    { "op": "revise", "weakKeepAlive": true, "internalKeepAlive": true,
      "reason": "参数修订：弱引用边视为保活（用于对照实验，不覆盖 v1 结论）" },
    { "op": "analyze", "snapshot": "snap-scn-weak", "paramsVersion": 2 },
    { "op": "decision", "subject": "snap-scn-weak:O2:retention", "verdict": "ACCEPT",
      "rationale": "采纳 v1（weakKeepAlive=false）：GC 语义下弱引用不保活，O2 是可回收目标",
      "reviewer": "reviewer-alpha", "paramsVersion": 1 },
    { "op": "decision", "subject": "snap-scn-weak:O2:retention", "verdict": "REJECT",
      "rationale": "未采纳 v2（weakKeepAlive=true）：该结果只在显式保活实验下成立，不代表默认 GC 语义",
      "reviewer": "reviewer-alpha", "paramsVersion": 2 },
    { "op": "patch", "parent": "snap-base-001", "patchName": "pinned-entry",
      "file": "patch-dupaddr.hsf", "description": "一次只影响局部依赖的源数据改动：向 O2 保留子树追加 P1" },
    { "op": "analyze", "snapshot": "snap-base-001+pinned-entry", "paramsVersion": 2 },
    { "op": "diff", "a": "snap-scn-rename-a", "b": "snap-scn-rename-b" },
    { "op": "decision", "subject": "snap-base-001:O2:leak", "verdict": "ACCEPT",
      "rationale": "认为 O2 保留链是泄漏候选（缓存未释放会话）",
      "reviewer": "reviewer-alpha", "paramsVersion": 1 },
    { "op": "decision", "subject": "snap-base-001:O2:leak", "verdict": "REJECT",
      "rationale": "冲突决定：认为 O2 是应用正常持有的活跃缓存，非泄漏；两条决定并存",
      "reviewer": "reviewer-beta", "paramsVersion": 1 }
  ]
}
